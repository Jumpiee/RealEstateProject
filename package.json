{
  "name": "RealEstateProject",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @RealEstateProject/db --",
    "db:studio": "turbo run db:studio -F @RealEstateProject/db --",
    "db:generate": "turbo run db:generate -F @RealEstateProject/db --",
    "db:migrate": "turbo run db:migrate -F @RealEstateProject/db --",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check": "biome check --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@RealEstateProject/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@RealEstateProject/config": "workspace:*",
    "@biomejs/biome": "^2.5.11",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write ."
    ]
  },
  "packageManager": "pnpm@12.3.4"
}
