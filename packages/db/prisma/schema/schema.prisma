generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId       BigInt        @id @default(autoincrement()) @map("user_id")
  username     String        @unique @db.VarChar(50)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  owners       Owner[]
  properties   Property[]
  buyers        Buyer[]
  appointments Appointment[]
  statusChanges StatusHistory[]

  @@map("user")
}

model Owner {
  ownerId    BigInt     @id @default(autoincrement()) @map("owner_id")
  userId     BigInt     @map("user_id")
  name       String     @db.VarChar(150)
  phone      String     @db.VarChar(10)
  user       User       @relation(fields: [userId], references: [userId], onDelete: Restrict)
  properties Property[]
  appointments Appointment[]

  @@unique([ownerId, userId])
  @@index([userId])
  @@map("owner")
}

model Property {
  propertyId       BigInt              @id @default(autoincrement()) @map("property_id")
  userId           BigInt              @map("user_id")
  ownerId          BigInt              @map("owner_id")
  name             String              @db.VarChar(150)
  type             String              @db.VarChar(50)
  address          String              @db.Text
  area             Decimal             @db.Decimal(12, 2)
  price            Decimal             @db.Decimal(14, 2)
  status           String              @default("available") @db.VarChar(20)
  description      String?             @db.Text
  user             User                @relation(fields: [userId], references: [userId], onDelete: Restrict)
  owner            Owner               @relation(fields: [ownerId, userId], references: [ownerId, userId], onDelete: Restrict)
  publicationChecks PublicationCheck[]
  tasks            PropertyTask[]
  statusHistory    StatusHistory[]
  statusHistoryForAgent StatusHistory[] @relation("HistoryResponsibleAgent")
  appointments     Appointment[]       @relation("AppointmentProperty")
  ownedAppointments Appointment[]      @relation("AppointmentPropertyOwner")

  @@unique([propertyId, userId])
  @@unique([propertyId, ownerId, userId])
  @@index([userId])
  @@index([ownerId, userId])
  @@map("property")
}

model Buyer {
  buyerId      BigInt        @id @default(autoincrement()) @map("buyer_id")
  userId       BigInt        @map("user_id")
  name         String        @db.VarChar(150)
  phone        String        @db.VarChar(10)
  requirements String?       @db.Text
  budget       Decimal?      @db.Decimal(14, 2)
  income       Decimal?      @db.Decimal(12, 2)
  user         User          @relation(fields: [userId], references: [userId], onDelete: Restrict)
  appointments Appointment[]

  @@unique([buyerId, userId])
  @@index([userId])
  @@map("buyer")
}

model Appointment {
  appointmentId BigInt    @id @default(autoincrement()) @map("appointment_id")
  userId        BigInt    @map("user_id")
  ownerId       BigInt?   @map("owner_id")
  buyerId       BigInt    @map("buyer_id")
  propertyId    BigInt    @map("property_id")
  appointmentType String  @map("appointment_type") @db.VarChar(20)
  appointmentAt DateTime @map("appointment_at") @db.Timestamptz(6)
  endAt         DateTime  @map("end_at") @db.Timestamptz(6)
  status        String    @default("scheduled") @db.VarChar(20)
  details       String?   @db.Text
  user          User      @relation(fields: [userId], references: [userId], onDelete: Restrict)
  buyer         Buyer     @relation(fields: [buyerId, userId], references: [buyerId, userId], onDelete: Restrict)
  property      Property  @relation("AppointmentProperty", fields: [propertyId, userId], references: [propertyId, userId], onDelete: Restrict)
  propertyOwner Property? @relation("AppointmentPropertyOwner", fields: [propertyId, ownerId, userId], references: [propertyId, ownerId, userId], onDelete: Restrict)
  owner         Owner?    @relation(fields: [ownerId, userId], references: [ownerId, userId], onDelete: Restrict)

  @@index([userId, appointmentAt])
  @@index([userId, endAt])
  @@index([buyerId, userId])
  @@index([propertyId, userId])
  @@index([ownerId, userId])
  @@map("appointment")
}

model PropertyTask {
  taskId     BigInt   @id @default(autoincrement()) @map("task_id")
  propertyId BigInt   @map("property_id")
  stepName   String   @map("step_name") @db.VarChar(100)
  stepOrder  Int      @map("step_order")
  property   Property @relation(fields: [propertyId], references: [propertyId], onDelete: Restrict)

  @@unique([propertyId, stepOrder])
  @@index([propertyId])
  @@map("property_task")
}

model PublicationCheck {
  publicationCheckId BigInt    @id @default(autoincrement()) @map("publication_check_id")
  propertyId         BigInt    @map("property_id")
  websiteName        String    @map("website_name") @db.VarChar(100)
  isPublished        Boolean   @default(false) @map("is_published")
  publishedAt       DateTime? @map("published_at") @db.Timestamptz(6)
  property           Property  @relation(fields: [propertyId], references: [propertyId], onDelete: Restrict)

  @@unique([propertyId, websiteName])
  @@index([propertyId])
  @@map("publication_check")
}

model StatusHistory {
  historyId  BigInt   @id @default(autoincrement()) @map("history_id")
  propertyId BigInt   @map("property_id")
  changedBy  BigInt   @map("changed_by")
  oldStatus  String   @map("old_status") @db.VarChar(20)
  newStatus  String   @map("new_status") @db.VarChar(20)
  changedAt  DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  property   Property @relation(fields: [propertyId], references: [propertyId], onDelete: Restrict)
  responsibleProperty Property @relation("HistoryResponsibleAgent", fields: [propertyId, changedBy], references: [propertyId, userId], onDelete: Restrict)
  user       User     @relation(fields: [changedBy], references: [userId], onDelete: Restrict)

  @@index([propertyId])
  @@index([changedBy])
  @@map("property_status_history")
}
